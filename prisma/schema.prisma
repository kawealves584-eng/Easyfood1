// Prisma schema do EasyFood
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id       Int    @id @default(autoincrement())
  name     String
  category String
  rating   Float  @default(0)
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}
