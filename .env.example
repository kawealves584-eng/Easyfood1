# Copie este arquivo para .env e preencha com os seus valores.
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).

# String de conexão com o MySQL
DATABASE_URL="mysql://usuario:senha@localhost:3306/easyfood"

# Segredo usado para assinar os tokens JWT (use uma chave longa e aleatória)
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"
